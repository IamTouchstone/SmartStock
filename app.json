{
  "expo": {
    "name": "SmartStock",
    "slug": "smartstock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icons/icon-512.png",
    "scheme": "smartstock",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./public/icons/icon-512.png"
      },
      "package": "com.smartstock.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
